{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:db:staging": "vitest run --config vitest.db.config.mts --mode staging",
    "make-admin:staging": "node --env-file=.env.staging.local scripts/make-admin.mjs",
    "demo:load:staging": "node --env-file=.env.staging.local scripts/seed-demo.mjs load",
    "demo:remove:staging": "node --env-file=.env.staging.local scripts/seed-demo.mjs remove",
    "demo:load": "node --env-file=.env.local scripts/seed-demo.mjs load",
    "demo:remove": "node --env-file=.env.local scripts/seed-demo.mjs remove",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --remote > src/lib/supabase/database.types.ts",
    "make-admin": "node --env-file=.env.local scripts/make-admin.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@sentry/nextjs": "^11.11.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "supabase": "^3.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
