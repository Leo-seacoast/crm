# ---------------------------------------------------------------------------
# TEMPLATE ONLY — this file is committed to Git, so it must NEVER hold real values.
#
# Your computer (development):
#   Copy this file to  .env.local  and fill it in with the crm-dev project's values.
#
# Staging database tests (optional):
#   Copy this file to  .env.staging.local  and fill it in with the crm-staging values,
#   with APP_ENV=staging.
#
# Staging / production websites:
#   Enter the same settings in the hosting dashboard (Vercel -> Settings -> Environment Variables).
#
# All .env*.local files are ignored by Git and stay private.
# ---------------------------------------------------------------------------

# Which environment this is: development | staging | production
# Controls safety features (e.g. in development/staging all email/SMS goes to the owner only).
APP_ENV=development
# Same value again, readable by the browser (used to label error reports).
NEXT_PUBLIC_APP_ENV=development

# Supabase — find these in your Supabase project: Project Settings -> API Keys
# The URL and publishable key are safe to be seen by the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET — server only. Gives full access to the database, bypassing security rules.
# Never share it, never paste it into chat, never put it in code.
SUPABASE_SECRET_KEY=

# Sentry error alerts — leave EMPTY on your computer (nothing is sent from development).
# Set only on staging/production hosting. The DSN is Sentry's address for this app (not a secret).
NEXT_PUBLIC_SENTRY_DSN=
# Optional, hosting only: lets Sentry show readable error locations.
# SENTRY_AUTH_TOKEN is a SECRET.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
