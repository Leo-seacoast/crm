# ---------------------------------------------------------------------------
# TEMPLATE ONLY — this file is committed to Git, so it must NEVER hold real values.
#
# To set up your computer:
#   1. Copy this file and name the copy  .env.local
#   2. Fill in the values in .env.local (that file is ignored by Git and stays private)
# ---------------------------------------------------------------------------

# Which environment this is: development | staging | production
# Controls safety features (e.g. in development/staging all email/SMS goes to the owner only).
APP_ENV=development

# Supabase — find these in your Supabase project: Project Settings -> API Keys
# The URL and publishable key are safe to be seen by the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET — server only. Gives full access to the database, bypassing security rules.
# Never share it, never paste it into chat, never put it in code.
SUPABASE_SECRET_KEY=
